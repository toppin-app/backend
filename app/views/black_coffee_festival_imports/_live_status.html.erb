<div data-festival-import-snapshot data-finished="<%= @run.finished? %>">
  <% if @run.dry_run? %>
    <div class="alert alert-warning">
      <strong>Esta ejecución es una simulación.</strong>
      Los candidatos se analizan, pero no se crea ningún festival en Black Coffee.
    </div>
  <% elsif @run.venues_created_count.to_i.positive? %>
    <div class="alert alert-success d-flex flex-wrap justify-content-between align-items-center">
      <span><strong><%= @run.venues_created_count %> festivales creados.</strong> Ya puedes consultarlos en el panel de Black Coffee.</span>
      <%= link_to 'Abrir festivales', black_coffee_venues_path(category: 'festival'), class: 'btn btn-sm btn-outline-success mt-2 mt-md-0' %>
    </div>
  <% end %>

  <div class="row mb-4">
    <div class="col-6 col-lg-2 mb-3">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <p class="text-muted text-uppercase font-weight-bold mb-2">Estado</p>
        <span class="badge badge-<%= @run.status_badge_class %> p-2"><%= @run.status_label %></span>
        <div class="small text-muted mt-2"><%= @run.mode_label %></div>
      </div></div>
    </div>
    <div class="col-6 col-lg-2 mb-3">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <p class="text-muted text-uppercase font-weight-bold mb-2">Festivales analizados</p>
        <h2 class="mb-0"><%= @run.candidates_found_count %></h2>
      </div></div>
    </div>
    <div class="col-6 col-lg-2 mb-3">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <p class="text-muted text-uppercase font-weight-bold mb-2">Creados</p>
        <h2 class="mb-0 text-success"><%= @run.venues_created_count %></h2>
      </div></div>
    </div>
    <div class="col-6 col-lg-2 mb-3">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <p class="text-muted text-uppercase font-weight-bold mb-2">Fuera de España</p>
        <h2 class="mb-0 text-warning"><%= @run.outside_country_skipped_count %></h2>
      </div></div>
    </div>
    <div class="col-6 col-lg-2 mb-3">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <p class="text-muted text-uppercase font-weight-bold mb-2">Duplicados</p>
        <h2 class="mb-0"><%= @run.duplicate_skipped_count %></h2>
      </div></div>
    </div>
    <div class="col-6 col-lg-2 mb-3">
      <div class="card border-0 shadow-sm h-100"><div class="card-body">
        <p class="text-muted text-uppercase font-weight-bold mb-2">Requests</p>
        <h2 class="mb-0"><%= @run.robots_requests_count.to_i + @run.listing_requests_count.to_i + @run.detail_requests_count.to_i %></h2>
        <div class="small text-muted">robots <%= @run.robots_requests_count %> · listado <%= @run.listing_requests_count %> · detalle <%= @run.detail_requests_count %></div>
      </div></div>
    </div>
  </div>

  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body d-flex flex-wrap justify-content-between align-items-center">
      <div>
        <h4 class="mb-1">Configuración de esta importación</h4>
        <p class="text-muted mb-0">
          Páginas: <strong><%= @run.max_pages %></strong> ·
          Operación: <strong><%= @run.operation_label %></strong> ·
          Detalles: <strong><%= @run.refresh_details? || @run.import_details? ? "sí (máx. #{@run.max_details})" : 'no' %></strong> ·
          Solo futuros: <strong><%= @run.only_future? ? 'sí' : 'no' %></strong> ·
          Imágenes: <strong><%= @run.download_images? ? "binario (#{@run.images_downloaded_count.to_i} descargadas)" : 'solo URL' %></strong> ·
          Delay: <strong><%= @run.request_delay_seconds.to_f.to_i %>s</strong> ·
          País: <strong><%= @run.strict_country_code %></strong>
        </p>
        <% if @run.error_message.present? %>
          <div class="alert alert-danger mt-3 mb-0"><%= @run.error_message %></div>
        <% end %>
      </div>
      <% unless @run.finished? %>
        <%= button_to 'Cancelar importación',
                      cancel_black_coffee_festival_import_path(@run),
                      method: :post,
                      class: 'btn btn-outline-danger mt-3 mt-md-0',
                      data: { confirm: '¿Cancelar esta importación? No se borrarán los festivales ya creados.' } %>
      <% end %>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center">
      <h4 class="mb-0">Festivales de la importación</h4>
      <% unless @run.finished? %><span class="small text-muted">Actualización automática activa</span><% end %>
    </div>
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead><tr>
          <th>Estado</th><th>Festival</th><th>Ubicación</th><th>Fechas</th><th>Coordenadas</th><th>Descripción fuente</th><th>Local</th><th>Mensaje</th>
        </tr></thead>
        <tbody>
          <% if @items.any? %>
            <% @items.each do |item| %>
              <tr>
                <td><span class="badge badge-<%= item.status_badge_class %>"><%= item.status_label %></span></td>
                <td>
                  <strong><%= item.name.presence || 'Sin nombre' %></strong>
                  <% if item.safe_source_url.present? %>
                    <div class="mt-2"><%= link_to 'Ver en FanMusicFest', item.safe_source_url, target: '_blank', rel: 'noopener noreferrer', class: 'btn btn-sm btn-outline-primary' %></div>
                  <% else %>
                    <div class="small text-muted mt-1">Sin URL de origen</div>
                  <% end %>
                </td>
                <td><%= [item.city, item.state, item.country].compact.reject(&:blank?).join(' · ') %><div class="small text-muted"><%= item.country_code %></div></td>
                <td><%= [item.start_date, item.end_date].compact.map { |date| l(date, format: :short) }.join(' - ') %></td>
                <td>
                  <% if item.coordinates_present? %>
                    <strong><%= number_with_precision(item.latitude, precision: 6) %>, <%= number_with_precision(item.longitude, precision: 6) %></strong>
                    <div class="small text-muted"><%= item.coordinates_source.presence || 'Fuente sin registrar' %> · <%= item.coordinates_confidence.presence || 'sin confianza' %></div>
                    <%= link_to 'Abrir mapa', item.map_url, target: '_blank', rel: 'noopener noreferrer', class: 'small' %>
                  <% else %>
                    <span class="badge badge-warning">Sin coordenadas</span>
                  <% end %>
                </td>
                <td class="small" style="min-width: 240px;">
                  <% if item.source_description.present? %>
                    <div class="mb-1"><span class="badge badge-warning"><%= item.source_description_status.presence || 'needs_review' %></span> <span class="text-muted"><%= item.source_description_language.presence || 'idioma sin registrar' %></span></div>
                    <%= truncate(item.source_description, length: 220) %>
                  <% else %>
                    <span class="text-muted">No encontrada</span>
                  <% end %>
                </td>
                <td><%= item.venue.present? ? link_to(item.venue_id, black_coffee_venue_path(item.venue), class: 'btn btn-sm btn-outline-primary') : content_tag(:span, '-', class: 'text-muted') %></td>
                <td class="small">
                  <% if item.error_message.present? %><div class="text-danger"><%= item.error_message %></div><% end %>
                  <% if item.warning_message.present? %><div class="text-warning"><%= item.warning_message %></div><% end %>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr><td colspan="8" class="text-center text-muted py-4"><%= @run.finished? ? 'No se encontraron festivales para mostrar.' : 'Buscando festivales… Esta tabla se actualizará automáticamente.' %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="card-footer bg-white"><%= will_paginate @items if @items.respond_to?(:total_pages) %></div>
  </div>
</div>
