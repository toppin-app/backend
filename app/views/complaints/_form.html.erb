<%= form_with(model: complaint, local: true) do |form| %>
  <% if complaint.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(complaint.errors.count, "error") %> prohibited this complaint from being saved:</h2>

      <ul>
        <% complaint.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if complaint.persisted? %>
    <p><strong>User:</strong> <%= complaint.user_id %></p>
    <p><strong>To user:</strong> <%= complaint.to_user_id %></p>
    <p><strong>Reason:</strong> <%= complaint.reason %></p>
    <p><strong>Text:</strong> <%= complaint.text %></p>
    <div class="field">
      <%= form.label :action_taken %>
      <%= form.select :action_taken, Complaint::ACTION_OPTIONS %>
    </div>
  <% else %>
    <div class="field">
      <%= form.label :to_user_id %>
      <%= form.number_field :to_user_id %>
    </div>
    <div class="field">
      <%= form.label :reason %>
      <%= form.text_field :reason %>
    </div>
    <div class="field">
      <%= form.label :text %>
      <%= form.text_area :text %>
    </div>
  <% end %>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
