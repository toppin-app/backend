<div class="d-flex flex-wrap justify-content-between align-items-start mb-4">
  <div>
    <div class="text-muted font-weight-bold">Black Coffee / Songkick</div>
    <h1 class="mb-1">Importación de conciertos #<%= @run.id %></h1>
    <p class="text-muted mb-0">Progreso, descartes y conciertos creados desde Songkick.</p>
  </div>
  <div class="mt-3 mt-md-0">
    <%= link_to 'Volver al importador', black_coffee_concert_imports_path, class: 'btn btn-outline-secondary mr-2' %>
    <%= link_to 'Ver conciertos en Black Coffee', black_coffee_venues_path(category: 'concierto'), class: 'btn btn-outline-primary' %>
  </div>
</div>

<div id="concert-import-live" aria-live="polite">
  <%= render 'live_status' %>
</div>

<script>
  (() => {
    const container = document.getElementById('concert-import-live');
    if (!container) return;

    const statusUrl = <%= raw status_black_coffee_concert_import_path(@run, page: params[:page]).to_json %>;
    let timer = null;
    let requestInFlight = false;

    const schedule = (delay = 2500) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(refresh, delay);
    };

    const refresh = async () => {
      const currentSnapshot = container.querySelector('[data-concert-import-snapshot]');
      if (!currentSnapshot || currentSnapshot.dataset.finished === 'true') return;
      if (document.hidden) return schedule(5000);
      if (requestInFlight) return schedule();

      requestInFlight = true;
      container.setAttribute('aria-busy', 'true');

      try {
        const response = await window.fetch(statusUrl, {
          credentials: 'same-origin',
          cache: 'no-store',
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);

        const template = document.createElement('template');
        template.innerHTML = (await response.text()).trim();
        const nextSnapshot = template.content.querySelector('[data-concert-import-snapshot]');
        if (!nextSnapshot) throw new Error('Respuesta de progreso inválida');

        container.replaceChildren(nextSnapshot);
        if (nextSnapshot.dataset.finished !== 'true') schedule();
      } catch (error) {
        console.warn('No se pudo actualizar el progreso de conciertos:', error);
        schedule(5000);
      } finally {
        requestInFlight = false;
        container.removeAttribute('aria-busy');
      }
    };

    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) schedule(250);
    });
    schedule();
  })();
</script>
