<style>
  .concert-cover-tool-card { border: 0; border-radius: 16px; box-shadow: 0 8px 24px rgba(15, 23, 42, 0.08); }
  .concert-cover-stat { color: #172033; font-size: 34px; font-weight: 900; letter-spacing: -0.04em; }
  .concert-cover-label { color: #64748b; font-size: 12px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase; }
</style>

<div class="d-flex flex-wrap justify-content-between align-items-start mb-4">
  <div>
    <div class="text-muted font-weight-bold">Black Coffee / Conciertos</div>
    <h1 class="mb-1">Recuperar portadas de conciertos</h1>
    <p class="text-muted mb-0">Recupera portadas como binarios internos y separa los conciertos que no tengan una imagen verificable.</p>
  </div>
  <div class="mt-3 mt-md-0">
    <%= link_to 'Importador de conciertos', black_coffee_concert_imports_path, class: 'btn btn-outline-primary mr-2' %>
    <%= link_to 'Volver a conciertos', black_coffee_venues_path(category: 'concierto'), class: 'btn btn-outline-secondary' %>
  </div>
</div>

<div class="alert alert-warning">
  <strong>Proceso modificador y no destructivo.</strong>
  Primero reintenta la URL y la ficha exacta de Songkick. Opcionalmente consulta Brave Image Search una sola vez por concierto y solo acepta coincidencias estrictas por nombre, fecha y ubicacion. Solo se marca como <strong>rechazado por fotos</strong> cuando todas las vias habilitadas terminan sin una imagen valida; una caida de red o servicio queda como fallo reintentable y no cambia el concierto.
</div>

<div class="row mb-4">
  <div class="col-md-6 mb-3">
    <div class="card concert-cover-tool-card h-100"><div class="card-body">
      <div class="concert-cover-label">Aprobados sin portada interna</div>
      <div class="concert-cover-stat"><%= number_with_delimiter(@missing_cover_counts[:approved]) %></div>
    </div></div>
  </div>
  <div class="col-md-6 mb-3">
    <div class="card concert-cover-tool-card h-100"><div class="card-body">
      <div class="concert-cover-label">Pendientes sin portada interna</div>
      <div class="concert-cover-stat"><%= number_with_delimiter(@missing_cover_counts[:pending]) %></div>
    </div></div>
  </div>
</div>

<div class="card concert-cover-tool-card mb-4">
  <div class="card-header bg-white"><h4 class="mb-0">Crear proceso en servidor</h4></div>
  <div class="card-body">
    <%= form_with url: black_coffee_concert_cover_repairs_path, method: :post, local: true do %>
      <div class="form-row align-items-end">
        <div class="form-group col-md-4">
          <%= label_tag :review_status_filter, 'Conciertos a revisar' %>
          <%= select_tag :review_status_filter,
                         options_for_select([
                           ['Solo aprobados', 'approved'],
                           ['Solo pendientes', 'pending'],
                           ['Aprobados y pendientes', 'active']
                         ], 'approved'),
                         class: 'form-control' %>
        </div>
        <div class="form-group col-md-3">
          <%= label_tag :limit, 'Tamano de cada bloque' %>
          <%= number_field_tag :limit,
                               BlackCoffeeConcertCoverRepairRunner::DEFAULT_LIMIT,
                               min: 1,
                               max: BlackCoffeeConcertCoverRepairRunner::MAX_LIMIT,
                               class: 'form-control' %>
          <small class="text-muted">Maximo <%= BlackCoffeeConcertCoverRepairRunner::MAX_LIMIT %>; cada ficha de origen respeta el delay de Songkick.</small>
        </div>
        <div class="form-group col-md-3">
          <%= hidden_field_tag :external_search_enabled, '0' %>
          <div class="custom-control custom-switch mb-2">
            <%= check_box_tag :external_search_enabled,
                              '1',
                              @search_configured,
                              class: 'custom-control-input',
                              id: 'concert_cover_external_search',
                              disabled: !@search_configured %>
            <%= label_tag :concert_cover_external_search, 'Fallback de busqueda web', class: 'custom-control-label' %>
          </div>
          <small class="text-muted"><%= @search_configured ? 'Brave Image Search configurado.' : 'No disponible: falta BRAVE_SEARCH_API_KEY.' %></small>
        </div>
        <div class="form-group col-md-2">
          <%= submit_tag 'Iniciar proceso',
                         class: 'btn btn-danger btn-block text-white',
                         data: { confirm: 'Los conciertos sin ninguna portada verificable quedaran rechazados y ocultos. El proceso continuara en el servidor. Continuar?' } %>
        </div>
      </div>
    <% end %>
  </div>
</div>

<div class="card concert-cover-tool-card">
  <div class="card-header bg-white"><h4 class="mb-0">Procesos recientes</h4></div>
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>#</th><th>Estado</th><th>Filtro</th><th>Progreso</th><th>Origen</th><th>Busqueda</th><th>Rechazados</th><th>Requests</th><th>Fecha</th><th></th></tr></thead>
      <tbody>
        <% @recent_batches.each do |batch| %>
          <tr>
            <td><strong>#<%= batch.id %></strong></td>
            <td><span class="badge badge-<%= batch.status_badge_class %>"><%= batch.status_label %></span></td>
            <td><%= batch.review_status_filter_label %></td>
            <td><strong><%= batch.progress_percentage %>%</strong><br><small class="text-muted"><%= batch.processed_venues %>/<%= batch.total_venues %></small></td>
            <td class="text-success"><%= batch.source_recovered_count %></td>
            <td class="text-primary"><%= batch.search_recovered_count %></td>
            <td class="text-danger"><%= batch.rejected_count %></td>
            <td><%= batch.source_requests_count.to_i + batch.search_requests_count.to_i + batch.image_requests_count.to_i %></td>
            <td><%= l(batch.created_at, format: :short) %></td>
            <td class="text-right"><%= link_to 'Ver progreso', black_coffee_concert_cover_repair_path(batch), class: 'btn btn-sm btn-outline-primary' %></td>
          </tr>
        <% end %>
        <% if @recent_batches.empty? %>
          <tr><td colspan="10" class="text-center text-muted py-4">Todavia no hay procesos de recuperacion de portadas.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
