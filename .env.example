# Elasticsearch Configuration
# ================================
# Configuración para conectar con los contenedores de Elasticsearch y Kibana en EasyPanel

# Elasticsearch Settings (using HTTPS URL)
ELASTICSEARCH_URL=https://web-elasticsearch-logs.uao3jo.easypanel.host:443
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=elasticsearch-logs
ELASTICSEARCH_SECURITY_ENABLED=true

# Enable/Disable Elasticsearch logging (set to "true" to enable)
ENABLE_ELASTICSEARCH_LOGGING=true

# Kibana URL (for reference - not used in Rails app directly)
KIBANA_URL=http://web_kibana-logs:5601/

# Rails Settings
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# Database Settings (you may already have these)
# DATABASE_URL=mysql2://user:password@host:port/database_name

# Concert importer (optional/existing integrations)
# GOOGLE_PLACES_API_KEY=replace-with-your-existing-key
# CONCERT_COVER_SEARCH_USER_AGENT=ToppinConcertCoverSearch/1.0 (+https://your-domain.example)
# MUSICBRAINZ_REQUEST_INTERVAL_SECONDS=1.0

# Other existing environment variables...
# Add your other environment variables here
